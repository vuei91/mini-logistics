# docker-compose.prod.yml 에서 사용하는 운영 환경변수
# 실제 배포 시 이 파일을 .env.prod 로 복사한 뒤 값을 채운다.
#   cp .env.prod.example .env.prod
# 실행:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- RDS PostgreSQL ---
# 예: jdbc:postgresql://cjlogistics.xxxxx.ap-northeast-2.rds.amazonaws.com:5432/cjlogistics
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/cjlogistics
DB_USERNAME=cjadmin
DB_PASSWORD=change-me-strong-password

# --- RabbitMQ ---
RABBITMQ_USERNAME=cjmq
RABBITMQ_PASSWORD=change-me-strong-password

# --- JWT (최소 32바이트 이상 랜덤 문자열) ---
JWT_SECRET=change-this-to-a-random-string-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600

# --- CORS: 프론트(CloudFront) 도메인 ---
# 예: https://dxxxx.cloudfront.net 또는 https://app.your-domain.com
CORS_ALLOWED_ORIGINS=https://<CLOUDFRONT_DOMAIN>
